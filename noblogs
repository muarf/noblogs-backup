#!/usr/bin/env bash
# noblogs — Lanceur multi-OS pour noblogs-backup (Tails / Ubuntu / macOS).
# La logique interactive est en Python (backup/wizard.py) :
#   ./noblogs                  → assistant interactif
#   ./noblogs sauvegarder S    → sauvegarde complète
#   ./noblogs republier [ZIP]  → republication WordPress.com ou locale
#   ./noblogs aide             → aide
set -euo pipefail

REPO_ROOT="$(cd "$(dirname "$0")" && pwd)"
VERSION="1.5.0"

# --- Couleurs (désactivées si pas de terminal) ---
if [ -t 1 ]; then
  G="\033[0;32m"; R="\033[0;31m"; Y="\033[1;33m"; C="\033[0;36m"; N="\033[0m"
else
  G=""; R=""; Y=""; C=""; N=""
fi
ok()   { echo -e "  ${G}✓${N} $*"; }
warn() { echo -e "  ${Y}!${N} $*"; }
err()  { echo -e "  ${R}✗${N} $*" >&2; }
info() { echo -e "  ${C}→${N} $*"; }

detect_platform() {
  if [ -f /etc/amnesia ] || [ -n "${TAILS_VERSION:-}" ]; then
    echo "tails"
  elif [ "$(uname -s)" = "Darwin" ]; then
    echo "macos"
  else
    echo "linux"
  fi
}

venv_dir() {
  local plat
  plat="$(detect_platform)"
  if [ "$plat" = "tails" ] && [ -d "${HOME}/Persistent" ]; then
    echo "${HOME}/Persistent/noblogs-backup/.venv"
  else
    echo "${REPO_ROOT}/.venv"
  fi
}

ensure_python() {
  if ! command -v python3 >/dev/null 2>&1; then
    err "Python 3 est requis."
    case "$(detect_platform)" in
      macos)  info "Installez-le : xcode-select --install  ou  brew install python3" ;;
      tails)  info "Sur Tails : Applications → Utilitaires → Terminal (Python 3 est inclus)." ;;
      *)      info "Installez-le : sudo apt install python3 python3-venv python3-pip" ;;
    esac
    exit 1
  fi
}

ensure_venv() {
  ensure_python
  local VENV
  VENV="$(venv_dir)"
  if [ ! -x "$VENV/bin/python3" ]; then
    info "Première utilisation : préparation de l'environnement (1 à 2 min)…"
    python3 -m venv "$VENV"
    "$VENV/bin/pip" install -q --upgrade pip
    "$VENV/bin/pip" install -q -r "$REPO_ROOT/requirements.txt"
    ok "Environnement prêt."
  fi
  export NOBLOGS_VENV="$VENV"
}

main() {
  cd "$REPO_ROOT"
  if [ "${1:-}" = "version" ] || [ "${1:-}" = "-V" ] || [ "${1:-}" = "--version" ]; then
    echo "noblogs ${VERSION}"
    return 0
  fi
  ensure_venv
  exec "$NOBLOGS_VENV/bin/python3" ${PYTHONUTF8:+-X utf8} -m backup wizard "$@"
}

main "$@"